FROM nvcr.io/nvidia/l4t-pytorch:r35.2.1-pth2.0-py3

# Robot control container for Jetson Orin Nano
# Contains: ROS 2, camera pipeline, SLAM, odometry, chassis control

# ============================================================================
# Install ROS 2 Humble
# ============================================================================
RUN apt-get update && apt-get install -y \
    curl \
    gnupg2 \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key -o /usr/share/keyrings/ros-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" | tee /etc/apt/sources.list.d/ros2.list > /dev/null

RUN apt-get update && apt-get install -y \
    ros-humble-ros-base \
    ros-humble-geometry-msgs \
    ros-humble-sensor-msgs \
    ros-humble-nav-msgs \
    ros-humble-tf2-ros \
    python3-colcon-common-extensions \
    && rm -rf /var/lib/apt/lists/*

# ============================================================================
# Install Camera & SLAM Dependencies
# ============================================================================
RUN apt-get update && apt-get install -y \
    librealsense2-dev \
    librealsense2-utils \
    ros-humble-realsense2-camera \
    ros-humble-image-transport \
    ros-humble-cv-bridge \
    && rm -rf /var/lib/apt/lists/*

# nvblox for SLAM (optional - can use rtabmap or other)
RUN apt-get update && apt-get install -y \
    ros-humble-nvblox-ros \
    && rm -rf /var/lib/apt/lists/* || echo "nvblox not available, will build from source if needed"

# ============================================================================
# Install Python Dependencies
# ============================================================================
RUN pip3 install --no-cache-dir \
    numpy \
    scipy \
    pyyaml \
    transforms3d

# ============================================================================
# Copy Source Code
# ============================================================================
WORKDIR /workspace

# Copy ROS packages
COPY src/ /workspace/src/

# Copy config
COPY config/ /workspace/config/

# ============================================================================
# Build ROS Workspace
# ============================================================================
RUN . /opt/ros/humble/setup.sh && \
    colcon build --symlink-install \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
        --packages-select \
            chassis_control \
            realsense_camera \
            custom_msgs \
            isaac_utils \
            nvblox_processor || echo "Build completed with warnings"

# ============================================================================
# Setup Entrypoint
# ============================================================================
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Source ROS setup
RUN echo "source /opt/ros/humble/setup.sh" >> ~/.bashrc
RUN echo "source /workspace/install/setup.sh" >> ~/.bashrc || true

ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "isaac_robot", "minimal_bringup.launch.py"]
