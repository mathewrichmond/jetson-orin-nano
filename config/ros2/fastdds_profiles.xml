<?xml version="1.0" encoding="UTF-8"?>
<!--
Fast DDS Profiles for ROS 2 Shared Memory Transport
Enables zero-copy communication between nodes on the same machine
Fixes "Not enough memory in the buffer stream" error by increasing resource limits
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- Default Publisher Profile -->
  <publisher profile_name="default_publisher" is_default_profile="true">
    <!-- CRITICAL: Set historyMemoryPolicy to DYNAMIC to allow resizing -->
    <historyMemoryPolicy>DYNAMIC</historyMemoryPolicy>
    <qos>
      <!-- Enable Data Sharing for zero-copy shared memory transport -->
      <data_sharing>
        <kind>AUTOMATIC</kind>
      </data_sharing>
      <!-- Reliability: RELIABLE for critical data -->
      <reliability>
        <kind>RELIABLE</kind>
      </reliability>
      <!-- Durability: VOLATILE (default) -->
      <durability>
        <kind>VOLATILE</kind>
      </durability>
    </qos>
    <!-- Topic-level QoS settings to fix buffer stream errors -->
    <topic>
      <!-- History: Keep last N messages -->
      <!-- Increased depth to match max_samples_per_instance -->
      <historyQos>
        <kind>KEEP_LAST</kind>
        <depth>500</depth>
      </historyQos>
      <!-- Resource Limits: Increase to handle large messages (images, pointclouds) -->
      <!-- Increased significantly to fix "Not enough memory in the buffer stream" error -->
      <resourceLimitsQos>
        <max_samples>5000</max_samples>
        <max_instances>20</max_instances>
        <max_samples_per_instance>500</max_samples_per_instance>
        <allocated_samples>500</allocated_samples>
      </resourceLimitsQos>
    </topic>
  </publisher>

  <!-- Default Subscriber Profile -->
  <subscriber profile_name="default_subscriber" is_default_profile="true">
    <!-- CRITICAL: Set historyMemoryPolicy to DYNAMIC to allow resizing -->
    <historyMemoryPolicy>DYNAMIC</historyMemoryPolicy>
    <qos>
      <!-- Enable Data Sharing for zero-copy shared memory transport -->
      <data_sharing>
        <kind>AUTOMATIC</kind>
      </data_sharing>
      <!-- Reliability: RELIABLE for critical data -->
      <reliability>
        <kind>RELIABLE</kind>
      </reliability>
      <!-- Durability: VOLATILE (default) -->
      <durability>
        <kind>VOLATILE</kind>
      </durability>
    </qos>
    <!-- Topic-level QoS settings to fix buffer stream errors -->
    <topic>
      <!-- History: Keep last N messages -->
      <!-- Increased depth to match max_samples_per_instance -->
      <historyQos>
        <kind>KEEP_LAST</kind>
        <depth>500</depth>
      </historyQos>
      <!-- Resource Limits: Increase to handle large messages (images, pointclouds) -->
      <!-- Increased significantly to fix "Not enough memory in the buffer stream" error -->
      <resourceLimitsQos>
        <max_samples>5000</max_samples>
        <max_instances>20</max_instances>
        <max_samples_per_instance>500</max_samples_per_instance>
        <allocated_samples>500</allocated_samples>
      </resourceLimitsQos>
    </topic>
  </subscriber>
</profiles>
