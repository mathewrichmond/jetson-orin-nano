[Unit]
Description=Isaac Robot System (Test Environment)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=nano
WorkingDirectory=/home/nano/src/jetson-orin-nano-dev
Environment="ROS_DOMAIN_ID=1"
Environment="ROS_LOG_DIR=/home/nano/.ros/log-test"
ExecStart=/bin/bash -c 'source install/setup.bash && ros2 launch isaac_robot robot.launch.py'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# No automatic start on boot for test service

[Install]
WantedBy=default.target
