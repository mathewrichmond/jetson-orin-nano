# Jetson Orin Nano - Docker-First Configuration
# Copy to .env and customize for your robot

# Robot Identification
ROBOT_ID=jetson-01
ROBOT_ROLE=robot

# Zenoh Communication
# Connect to server where dispatch/twin services run
# Use 'auto' for multicast discovery, or specify router address
ZENOH_ROUTER=tcp/192.168.1.100:7447

# ROS2 Domain (if using ROS2 bridge)
ROS_DOMAIN_ID=0

# Data Paths (on SSD /data partition)
DATA_PATH=/data
MCAP_PATH=/data/mcap
MODEL_PATH=/data/models
USD_PATH=/data/usd

# VLA Model
# Path to VLA model checkpoint inside control container
MODEL_PATH=/data/models/vla_latest.pth

# Development Mode
# Set to 'local' to mount ../robotics repo instead of git install
ROBOTICS_SDK_INSTALL=git

# Hardware Configuration (edit config/robot_config.yaml for details)
# These are used by setup scripts, containers read from config file
CAMERA_LEFT_SERIAL=12345678
CAMERA_RIGHT_SERIAL=87654321
SERVO_PORT=/dev/ttyUSB0
