import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy
from sensor_msgs.msg import Image
import time
import sys

DURATION = ${DURATION}
TOLERANCE_MS = ${TOLERANCE_MS}

# Use BEST_EFFORT QoS to match camera publishers
IMAGE_QOS = QoSProfile(
    reliability=ReliabilityPolicy.BEST_EFFORT,
    history=HistoryPolicy.KEEP_LAST,
    depth=10
)

class TimestampChecker(Node):
    def __init__(self):
        super().__init__('timestamp_checker')
        self.front_timestamps = []
        self.rear_timestamps = []
        self.front_sub = self.create_subscription(
            Image, '/hardware/camera_front/color/image_raw',
            self.front_callback, IMAGE_QOS
        )
        self.rear_sub = self.create_subscription(
            Image, '/hardware/camera_rear/color/image_raw',
            self.rear_callback, IMAGE_QOS
        )
        self.start_time = time.time()
        self.duration = DURATION

    def front_callback(self, msg):
        timestamp = msg.header.stamp.sec + msg.header.stamp.nanosec * 1e-9
        self.front_timestamps.append(timestamp)

    def rear_callback(self, msg):
        timestamp = msg.header.stamp.sec + msg.header.stamp.nanosec * 1e-9
        self.rear_timestamps.append(timestamp)

    def check_sync(self):
        if len(self.front_timestamps) == 0 or len(self.rear_timestamps) == 0:
            print("⚠ Not enough timestamps collected")
            print(f"  Front: {len(self.front_timestamps)} frames")
            print(f"  Rear:  {len(self.rear_timestamps)} frames")
            return

        tolerance = TOLERANCE_MS / 1000.0
        matched_pairs = []

        for front_ts in self.front_timestamps:
            for rear_ts in self.rear_timestamps:
                diff = abs(front_ts - rear_ts)
                if diff <= tolerance:
                    matched_pairs.append({
                        'front': front_ts,
                        'rear': rear_ts,
                        'diff': diff
                    })
                    break

        if len(matched_pairs) == 0:
            print("⚠ No synchronized timestamp pairs found")
            print(f"  Front timestamps: {len(self.front_timestamps)}")
            print(f"  Rear timestamps:  {len(self.rear_timestamps)}")
            print(f"  Tolerance: {tolerance*1000:.2f} ms")
            return

        diffs = [p['diff'] for p in matched_pairs]
        avg_diff = sum(diffs) / len(diffs) * 1000
        max_diff = max(diffs) * 1000
        min_diff = min(diffs) * 1000

        print(f"Analyzed {len(matched_pairs)} synchronized pairs:")
        print(f"  Average time difference: {avg_diff:.2f} ms")
        print(f"  Min time difference: {min_diff:.2f} ms")
        print(f"  Max time difference: {max_diff:.2f} ms")
        print(f"  Tolerance: {TOLERANCE_MS} ms")

        if avg_diff <= TOLERANCE_MS:
            print(f"  ✓ Average sync within tolerance")
        else:
            print(f"  ⚠ Average sync exceeds tolerance")

        if max_diff <= TOLERANCE_MS:
            print(f"  ✓ Max sync within tolerance")
        else:
            print(f"  ⚠ Max sync exceeds tolerance")

        sync_percentage = (len(matched_pairs) / min(len(self.front_timestamps), len(self.rear_timestamps))) * 100
        print(f"  Sync rate: {sync_percentage:.1f}%")

try:
    rclpy.init()
    checker = TimestampChecker()
    end_time = checker.start_time + checker.duration
    while time.time() < end_time:
        rclpy.spin_once(checker, timeout_sec=0.1)
    checker.check_sync()
    checker.destroy_node()
    rclpy.shutdown()
except Exception as e:
    print(f"Error checking timestamps: {e}")
    import traceback
    traceback.print_exc()
    sys.exit(1)
