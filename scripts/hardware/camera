#!/bin/bash
# Unified Camera Testing and Verification Tool
# Consolidates all camera-related testing and verification functionality

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
CYAN='\033[0;36m'
NC='\033[0m'

usage() {
    cat << EOF
Camera Testing and Verification Tool

Usage: camera <command> [options]

Commands:
  verify              Full verification (publishing + sync) - DEFAULT
  verify-sync         Check camera synchronization (hardware + software)
  diagnose            Run comprehensive camera diagnostics
  identify            Identify which camera is front vs rear
  check-topics        Check if camera topics are publishing
  check-rates         Check camera frame rates
  check-sync-status   Check sync status from nodes
  check-timestamps    Analyze timestamp synchronization

Options:
  --duration <sec>     Duration for verification (default: 10)
  --tolerance <ms>     Sync tolerance in milliseconds (default: 5.0)

Examples:
  camera verify                    # Full verification (10 seconds)
  camera verify --duration 20      # Verification with custom duration
  camera verify-sync               # Check sync only
  camera diagnose                 # Run diagnostics
  camera identify                 # Identify camera positions
  camera check-rates              # Check frame rates only

EOF
}

# Source ROS 2 if available
source_ros2() {
    if [ -f "/opt/ros/humble/setup.bash" ]; then
        source /opt/ros/humble/setup.bash > /dev/null 2>&1
    fi
    if [ -f ~/ros2_ws/install/setup.bash ]; then
        source ~/ros2_ws/install/setup.bash > /dev/null 2>&1
    fi
}

# Check RealSense SDK
check_realsense_sdk() {
    if ! python3 -c "import pyrealsense2" 2>/dev/null; then
        echo -e "${RED}✗ pyrealsense2 not installed${NC}"
        echo "  Run: sudo ./scripts/hardware/install_realsense.sh"
        return 1
    fi
    RS_VERSION=$(python3 -c "import pyrealsense2; print(pyrealsense2.__version__)" 2>/dev/null || echo "unknown")
    echo -e "${GREEN}✓${NC} pyrealsense2 version: $RS_VERSION"
    return 0
}

# Parse arguments
COMMAND="${1:-verify}"

# Handle help before parsing
if [[ "$COMMAND" == "-h" || "$COMMAND" == "--help" ]]; then
    usage
    exit 0
fi

shift || true

DURATION=10
TOLERANCE_MS=5.0

while [[ $# -gt 0 ]]; do
    case $1 in
        --duration)
            DURATION="$2"
            shift 2
            ;;
        --tolerance)
            TOLERANCE_MS="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            usage
            exit 1
            ;;
    esac
done

# Source ROS 2 for commands that need it
if [[ "$COMMAND" =~ ^(verify|verify-sync|check-topics|check-rates|check-sync-status|check-timestamps|identify)$ ]]; then
    source_ros2
fi

case "$COMMAND" in
    verify)
        echo "=========================================="
        echo "Camera Publishing and Sync Verification"
        echo "=========================================="
        echo ""
        echo -e "${CYAN}Duration: ${DURATION} seconds${NC}"
        echo ""

        # Check ROS 2
        if [ -z "$ROS_DISTRO" ]; then
            echo -e "${RED}✗ ROS 2 not sourced${NC}"
            exit 1
        fi

        # Check topics
        echo -e "${GREEN}1. Checking Camera Topics...${NC}"
        echo ""
        CAMERA_TOPICS=(
            "/hardware/camera_front/color/image_raw"
            "/hardware/camera_front/color/camera_info"
            "/hardware/camera_front/depth/image_rect_raw"
            "/hardware/camera_front/depth/camera_info"
            "/hardware/camera_rear/color/image_raw"
            "/hardware/camera_rear/color/camera_info"
            "/hardware/camera_rear/depth/image_rect_raw"
            "/hardware/camera_rear/depth/camera_info"
        )

        EXISTING_TOPICS=()
        MISSING_TOPICS=()

        TOPIC_LIST=$(ros2 topic list 2>/dev/null)
        for topic in "${CAMERA_TOPICS[@]}"; do
            if echo "$TOPIC_LIST" | grep -q "^${topic}$"; then
                EXISTING_TOPICS+=("$topic")
                echo -e "  ${GREEN}✓${NC} $topic"
            else
                MISSING_TOPICS+=("$topic")
                echo -e "  ${RED}✗${NC} $topic"
            fi
        done
        echo ""

        # Check frame rates
        echo -e "${GREEN}2. Checking Frame Rates (${DURATION}s)...${NC}"
        echo ""
        echo "  Color Images:"
        FRONT_COLOR_HZ=$(timeout "${DURATION}" ros2 topic hz /hardware/camera_front/color/image_raw 2>&1 | tail -n 1 | grep -oP 'average rate: \K[0-9.]+' || echo "N/A")
        REAR_COLOR_HZ=$(timeout "${DURATION}" ros2 topic hz /hardware/camera_rear/color/image_raw 2>&1 | tail -n 1 | grep -oP 'average rate: \K[0-9.]+' || echo "N/A")

        if [ "$FRONT_COLOR_HZ" != "N/A" ]; then
            echo -e "    Front: ${CYAN}${FRONT_COLOR_HZ} Hz${NC}"
        else
            echo -e "    Front: ${RED}N/A${NC}"
        fi

        if [ "$REAR_COLOR_HZ" != "N/A" ]; then
            echo -e "    Rear:  ${CYAN}${REAR_COLOR_HZ} Hz${NC}"
        else
            echo -e "    Rear:  ${RED}N/A${NC}"
        fi

        echo ""
        echo "  Depth Images:"
        FRONT_DEPTH_HZ=$(timeout "${DURATION}" ros2 topic hz /hardware/camera_front/depth/image_rect_raw 2>&1 | tail -n 1 | grep -oP 'average rate: \K[0-9.]+' || echo "N/A")
        REAR_DEPTH_HZ=$(timeout "${DURATION}" ros2 topic hz /hardware/camera_rear/depth/image_rect_raw 2>&1 | tail -n 1 | grep -oP 'average rate: \K[0-9.]+' || echo "N/A")

        if [ "$FRONT_DEPTH_HZ" != "N/A" ]; then
            echo -e "    Front: ${CYAN}${FRONT_DEPTH_HZ} Hz${NC}"
        else
            echo -e "    Front: ${RED}N/A${NC}"
        fi

        if [ "$REAR_DEPTH_HZ" != "N/A" ]; then
            echo -e "    Rear:  ${CYAN}${REAR_DEPTH_HZ} Hz${NC}"
        else
            echo -e "    Rear:  ${RED}N/A${NC}"
        fi

        echo ""

        # Check sync status
        echo -e "${GREEN}3. Checking Sync Status...${NC}"
        echo ""

        # RealSense status
        if ros2 topic list | grep -q "^/realsense/status$"; then
            echo "  RealSense Camera Status:"
            SYNC_MSG=$(timeout 2 ros2 topic echo /realsense/status --once 2>/dev/null | grep -i "sync" || echo "")
            if [ -n "$SYNC_MSG" ]; then
                echo -e "    ${GREEN}✓${NC} Sync status messages detected"
            else
                echo -e "    ${YELLOW}⚠${NC} No sync status messages"
            fi
        else
            echo -e "  ${YELLOW}⚠${NC} /realsense/status topic not found"
        fi

        echo ""

        # Sensor fusion sync status
        if ros2 topic list | grep -q "^/sensor_fusion/system/hardware/camera_sync_status$"; then
            echo "  Sensor Fusion Sync Status:"
            python3 << PYTHON_EOF
import rclpy
from rclpy.node import Node
from std_msgs.msg import String
import json
import time

class SyncStatusChecker(Node):
    def __init__(self):
        super().__init__('sync_status_checker')
        self.status_received = False
        self.sub = self.create_subscription(
            String, '/sensor_fusion/system/hardware/camera_sync_status',
            self.callback, 10
        )
        self.start_time = time.time()

    def callback(self, msg):
        try:
            status_data = json.loads(msg.data)
            status = status_data.get('status', 'unknown')
            time_diff = status_data.get('time_diff', 0.0)
            tolerance = status_data.get('tolerance', 0.05)
            num_cameras = status_data.get('num_cameras', 0)

            print(f"    Status: {status}")
            print(f"    Time Difference: {time_diff*1000:.2f} ms (tolerance: {tolerance*1000:.2f} ms)")
            print(f"    Number of Cameras: {num_cameras}")

            if status == "synced":
                print(f"    ✓ Cameras are synchronized")
            elif status == "not_synced":
                print(f"    ⚠ Cameras not synchronized")
            elif status == "single_camera":
                print(f"    ℹ Single camera mode")

            self.status_received = True
        except Exception as e:
            print(f"    ⚠ Error parsing sync status: {e}")

try:
    rclpy.init()
    checker = SyncStatusChecker()
    timeout = 3.0
    end_time = checker.start_time + timeout
    while time.time() < end_time and not checker.status_received:
        rclpy.spin_once(checker, timeout_sec=0.1)
    if not checker.status_received:
        print("    ⚠ No sync status messages received (timeout)")
    checker.destroy_node()
    rclpy.shutdown()
except Exception as e:
    print(f"    ✗ Error: {e}")
PYTHON_EOF
        else
            echo -e "  ${YELLOW}⚠${NC} Sync status topic not found"
            echo "    (Sensor fusion node may not be running)"
        fi

        echo ""

        # Timestamp synchronization
        echo -e "${GREEN}4. Checking Timestamp Synchronization...${NC}"
        echo ""
        python3 << PYTHON_EOF
import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy
from sensor_msgs.msg import Image
import time
import sys

DURATION = ${DURATION}
TOLERANCE_MS = ${TOLERANCE_MS}

# Use BEST_EFFORT QoS to match camera publishers
IMAGE_QOS = QoSProfile(
    reliability=ReliabilityPolicy.BEST_EFFORT,
    history=HistoryPolicy.KEEP_LAST,
    depth=10
)

class TimestampChecker(Node):
    def __init__(self):
        super().__init__('timestamp_checker')
        self.front_timestamps = []
        self.rear_timestamps = []
        self.front_sub = self.create_subscription(
            Image, '/hardware/camera_front/color/image_raw',
            self.front_callback, IMAGE_QOS
        )
        self.rear_sub = self.create_subscription(
            Image, '/hardware/camera_rear/color/image_raw',
            self.rear_callback, IMAGE_QOS
        )
        self.start_time = time.time()
        self.duration = DURATION

    def front_callback(self, msg):
        timestamp = msg.header.stamp.sec + msg.header.stamp.nanosec * 1e-9
        self.front_timestamps.append(timestamp)

    def rear_callback(self, msg):
        timestamp = msg.header.stamp.sec + msg.header.stamp.nanosec * 1e-9
        self.rear_timestamps.append(timestamp)

    def check_sync(self):
        if len(self.front_timestamps) == 0 or len(self.rear_timestamps) == 0:
            print("  ⚠ Not enough timestamps collected")
            print(f"    Front: {len(self.front_timestamps)} frames")
            print(f"    Rear:  {len(self.rear_timestamps)} frames")
            return

        tolerance = TOLERANCE_MS / 1000.0
        matched_pairs = []

        for front_ts in self.front_timestamps:
            for rear_ts in self.rear_timestamps:
                diff = abs(front_ts - rear_ts)
                if diff <= tolerance:
                    matched_pairs.append({
                        'front': front_ts,
                        'rear': rear_ts,
                        'diff': diff
                    })
                    break

        if len(matched_pairs) == 0:
            print("  ⚠ No synchronized timestamp pairs found")
            print(f"    Front timestamps: {len(self.front_timestamps)}")
            print(f"    Rear timestamps:  {len(self.rear_timestamps)}")
            print(f"    Tolerance: {tolerance*1000:.2f} ms")
            return

        diffs = [p['diff'] for p in matched_pairs]
        avg_diff = sum(diffs) / len(diffs) * 1000
        max_diff = max(diffs) * 1000
        min_diff = min(diffs) * 1000

        print(f"  Analyzed {len(matched_pairs)} synchronized pairs:")
        print(f"    Average time difference: {avg_diff:.2f} ms")
        print(f"    Min time difference: {min_diff:.2f} ms")
        print(f"    Max time difference: {max_diff:.2f} ms")
        print(f"    Tolerance: {TOLERANCE_MS} ms")

        if avg_diff <= TOLERANCE_MS:
            print(f"    ✓ Average sync within tolerance")
        else:
            print(f"    ⚠ Average sync exceeds tolerance")

        if max_diff <= TOLERANCE_MS:
            print(f"    ✓ Max sync within tolerance")
        else:
            print(f"    ⚠ Max sync exceeds tolerance")

        sync_percentage = (len(matched_pairs) / min(len(self.front_timestamps), len(self.rear_timestamps))) * 100
        print(f"    Sync rate: {sync_percentage:.1f}%")

try:
    rclpy.init()
    checker = TimestampChecker()
    end_time = checker.start_time + checker.duration
    while time.time() < end_time:
        rclpy.spin_once(checker, timeout_sec=0.1)
    checker.check_sync()
    checker.destroy_node()
    rclpy.shutdown()
except Exception as e:
    print(f"  ✗ Error checking timestamps: {e}")
    import traceback
    traceback.print_exc()
    sys.exit(1)
PYTHON_EOF

        echo ""
        echo "=========================================="
        echo "Verification Complete!"
        echo "=========================================="
        ;;

    verify-sync)
        echo "=========================================="
        echo "Camera Sync Hardware/Firmware Diagnostics"
        echo "=========================================="
        echo ""

        if ! check_realsense_sdk; then
            exit 1
        fi
        echo ""

        # Hardware/firmware check
        echo -e "${GREEN}Hardware/Firmware Status:${NC}"
        python3 << 'PYTHON_EOF'
import pyrealsense2 as rs
import sys

try:
    ctx = rs.context()
    devices = ctx.query_devices()

    if len(devices) == 0:
        print("ERROR: No RealSense devices found")
        sys.exit(1)

    print(f"Found {len(devices)} camera(s):\n")

    firmware_versions = []
    sync_modes = []

    for i, dev in enumerate(devices):
        serial = dev.get_info(rs.camera_info.serial_number)
        fw = dev.get_info(rs.camera_info.firmware_version)
        recommended = dev.get_info(rs.camera_info.recommended_firmware_version)
        name = dev.get_info(rs.camera_info.name)
        usb_type = dev.get_info(rs.camera_info.usb_type_descriptor)

        print(f"Camera {i+1}:")
        print(f"  Serial: {serial}")
        print(f"  Name: {name}")
        print(f"  Current FW: {fw}")
        print(f"  Recommended FW: {recommended}")
        print(f"  USB Type: {usb_type}")

        firmware_versions.append(fw)

        sensor = dev.first_depth_sensor()
        supports_sync = sensor.supports(rs.option.inter_cam_sync_mode)
        print(f"  Supports inter_cam_sync_mode: {supports_sync}")

        if supports_sync:
            try:
                current_mode = int(sensor.get_option(rs.option.inter_cam_sync_mode))
                mode_names = {0: 'None', 1: 'Master', 2: 'Slave'}
                mode_name = mode_names.get(current_mode, f'Unknown({current_mode})')
                print(f"  Current sync mode: {current_mode} ({mode_name})")
                sync_modes.append(current_mode)
            except Exception as e:
                print(f"  Error reading sync mode: {e}")
                sync_modes.append(None)
        else:
            sync_modes.append(None)
            print(f"  ⚠ Camera does not support hardware sync")

        print()

    if len(set(firmware_versions)) > 1:
        print("⚠ WARNING: Firmware version mismatch detected!")
        print("  Different firmware versions can cause sync issues.")
        print(f"  Recommended version: {devices[0].get_info(rs.camera_info.recommended_firmware_version)}")
        print()

    if len(sync_modes) >= 2:
        if sync_modes[0] == 1 and sync_modes[1] == 2:
            print("✓ Sync mode configuration correct (Master/Slave)")
        elif sync_modes[0] == 2 and sync_modes[1] == 1:
            print("✓ Sync mode configuration correct (Slave/Master)")
        elif sync_modes[0] == 0 or sync_modes[1] == 0:
            print("⚠ WARNING: One or both cameras have sync disabled")
        else:
            print("⚠ WARNING: Sync mode configuration may be incorrect")
        print()

    for i, dev in enumerate(devices):
        fw = dev.get_info(rs.camera_info.firmware_version)
        recommended = dev.get_info(rs.camera_info.recommended_firmware_version)
        if fw != recommended:
            print(f"⚠ Camera {i+1} firmware is outdated:")
            print(f"  Current: {fw}")
            print(f"  Recommended: {recommended}")
            print()

except Exception as e:
    print(f"ERROR: {e}")
    import traceback
    traceback.print_exc()
    sys.exit(1)
PYTHON_EOF

        echo ""
        echo -e "${GREEN}Testing Frame Capture with Sync Enabled:${NC}"
        echo ""

        python3 << 'PYTHON_EOF'
import pyrealsense2 as rs
import time
import sys

try:
    ctx = rs.context()
    devices = ctx.query_devices()

    if len(devices) < 2:
        print(f"⚠ Need 2 cameras for sync test, found: {len(devices)}")
        sys.exit(0)

    pipelines = []
    cameras_info = []

    for i, dev in enumerate(devices):
        serial = dev.get_info(rs.camera_info.serial_number)
        sensor = dev.first_depth_sensor()

        sync_mode = 0
        if sensor.supports(rs.option.inter_cam_sync_mode):
            sync_mode = int(sensor.get_option(rs.option.inter_cam_sync_mode))

        cameras_info.append({
            'serial': serial,
            'sync_mode': sync_mode,
            'mode_name': ['None', 'Master', 'Slave'][sync_mode] if sync_mode < 3 else 'Unknown'
        })

        pipeline = rs.pipeline()
        config = rs.config()
        config.enable_device(serial)
        config.enable_stream(rs.stream.color, 640, 480, rs.format.rgb8, 15)
        config.enable_stream(rs.stream.depth, 640, 480, rs.format.z16, 15)

        try:
            profile = pipeline.start(config)
            pipelines.append(pipeline)
            print(f"✓ Started pipeline for camera {i+1} (Serial: {serial[:8]}..., Mode: {cameras_info[i]['mode_name']})")
        except Exception as e:
            print(f"✗ Failed to start pipeline for camera {i+1}: {e}")
            sys.exit(1)

    print("\nCollecting frames for sync analysis...")
    time.sleep(2)

    timestamp_pairs = []
    max_samples = 30

    for sample in range(max_samples):
        frames_by_camera = {}

        for i, pipeline in enumerate(pipelines):
            try:
                frames = pipeline.wait_for_frames(timeout_ms=2000)
                color_frame = frames.get_color_frame()

                if color_frame:
                    try:
                        ts_ms = color_frame.get_frame_metadata(rs.frame_metadata_value.sensor_timestamp)
                    except:
                        ts_ms = color_frame.get_timestamp()

                    frames_by_camera[i] = {
                        'timestamp_ms': ts_ms,
                        'frame_number': color_frame.get_frame_number()
                    }
            except Exception as e:
                print(f"  Warning: Camera {i+1} frame timeout: {e}")
                break

        if len(frames_by_camera) == 2:
            ts1 = frames_by_camera[0]['timestamp_ms']
            ts2 = frames_by_camera[1]['timestamp_ms']
            delta_ms = abs(ts1 - ts2)
            timestamp_pairs.append({
                'ts1': ts1,
                'ts2': ts2,
                'delta_ms': delta_ms,
                'frame1': frames_by_camera[0]['frame_number'],
                'frame2': frames_by_camera[1]['frame_number']
            })

        time.sleep(0.1)

    for pipeline in pipelines:
        try:
            pipeline.stop()
        except:
            pass

    if len(timestamp_pairs) == 0:
        print("✗ No synchronized frame pairs collected")
        sys.exit(1)

    deltas = [p['delta_ms'] for p in timestamp_pairs]
    avg_delta = sum(deltas) / len(deltas)
    max_delta = max(deltas)
    min_delta = min(deltas)

    print(f"\nSync Analysis (from {len(timestamp_pairs)} frame pairs):")
    print(f"  Average delta: {avg_delta:.2f} ms")
    print(f"  Min delta: {min_delta:.2f} ms")
    print(f"  Max delta: {max_delta:.2f} ms")

    tolerance_ms = 5.0
    if avg_delta <= tolerance_ms:
        print(f"  ✓ Average sync delta within tolerance ({tolerance_ms} ms)")
    else:
        print(f"  ⚠ Average sync delta exceeds tolerance ({tolerance_ms} ms)")

    if max_delta <= tolerance_ms:
        print(f"  ✓ Max sync delta within tolerance ({tolerance_ms} ms)")
    else:
        print(f"  ⚠ Max sync delta exceeds tolerance ({tolerance_ms} ms)")

    within_tolerance = sum(1 for d in deltas if d <= tolerance_ms)
    percentage = (within_tolerance / len(deltas)) * 100
    print(f"  Frames within tolerance: {within_tolerance}/{len(deltas)} ({percentage:.1f}%)")

    if percentage < 80:
        print("\n⚠ WARNING: Less than 80% of frames are within sync tolerance")
        print("  Possible causes:")
        print("    - Firmware mismatch")
        print("    - Sync cable connection issues")
        print("    - USB bandwidth/power issues")
        print("    - Camera initialization timing")

except Exception as e:
    print(f"ERROR: {e}")
    import traceback
    traceback.print_exc()
    sys.exit(1)
